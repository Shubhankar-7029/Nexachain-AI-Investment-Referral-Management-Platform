            "url": {
              "raw": "{{baseUrl}}/investments?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
