              }
            ],
            "url": "{{baseUrl}}/dashboard"
          }
        },
        {
          "name": "All histories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/dashboard/histories"
          }
        }
      ]
    },
    {
      "name": "Investments",
