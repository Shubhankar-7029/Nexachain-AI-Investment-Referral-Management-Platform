        {
          "name": "Create investment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000,\n  \"planName\": \"Starter Plan\",\n  \"durationDays\": 30,\n  \"dailyRoiPercent\": 0.5\n}"
            },
            "url": "{{baseUrl}}/investments"
